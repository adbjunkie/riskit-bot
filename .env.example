# RiskIt Bot - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it's in .gitignore)

# === REQUIRED ===
TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The supergroup where anonymous photos will be posted.
# Must be a supergroup ID (starts with -100). Get it from @userinfobot or getUpdates.
GROUP_CHAT_ID=-1001234567890

# === OPTIONAL ===
# Your Telegram user ID (from @userinfobot). Useful for future admin commands.
ADMIN_USER_ID=5815775162

# Rate limiting (override if you want different values)
COOLDOWN_SECONDS=300
DAILY_LIMIT=10

# Data directory (Railway Volume should mount to /app/data)
DATA_DIR=data
