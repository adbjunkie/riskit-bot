# RiskIt Bot - Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it's in .gitignore)

# === REQUIRED ===
TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The supergroup where anonymous leaks are posted (starts with -100).
GROUP_CHAT_ID=-1001234567890

# === TRIBUTE TAB (optional) ===
# If set, a 🎁 Tribute button appears. Videos sent via tribute go to THIS group instead.
TRIBUTE_CHAT_ID=-1009999999999
# Optional public/invite link shown to users for the tribute group
TRIBUTE_INVITE_LINK=https://t.me/+your_tribute_invite

# === OPTIONAL ===
ADMIN_USER_ID=5815775162
COOLDOWN_SECONDS=300
DAILY_LIMIT=10
DATA_DIR=data
